# =============================================================================
# KIRITO - BTC 5m early-entry 4-strike opposite strategy
# =============================================================================
# Live: set POLY_DRY_RUN=false and real keys. Keep BOT_STRATEGY_MODE=kirito_early4.

POLY_PRIVATE_KEY=replace_me
# Profile / Deposit address from polymarket.com. Usually not your MetaMask EOA.
POLY_FUNDER=replace_me
# 1=email/Magic proxy | 2=browser wallet Safe | 3=deposit wallet / POLY_1271
POLY_SIGNATURE_TYPE=2
# If Magic/proxy wallet fails on CLOB v2, try legacy client:
# BOT_CLOB_USE_V1=true
POLY_DRY_RUN=true

RELAYER_API_KEY=
RELAYER_SECRET=
RELAYER_PASSPHRASE=

BOT_STRATEGY_MODE=kirito_early4
BOT_MARKET_SYMBOL=BTC
BOT_WINDOW_MINUTES=5

# --- KIRITO trading ---
# After 3 same resolved windows, buy the opposite side in the 5th window.
# If the 4th confirms, the 6th is already pre-armed. After a win, that next
# position is kept as orphan exposure and the martingale cycle ends.
KIRITO_SYMBOL=BTC
KIRITO_WINDOW_MINUTES=5
KIRITO_BASE_PCT=0.01
KIRITO_BASE_MAX_USDC=20
KIRITO_MULTIPLIER=2.0
KIRITO_PRICE_PAD=0.02
KIRITO_MIN_SHARES=5
KIRITO_FAK_BALANCE_THRESHOLD=250
KIRITO_FAK_MIN_USDC=1
KIRITO_SHARE_ROUND_DP=1
KIRITO_POLL_SECONDS=5
KIRITO_HISTORY_WINDOWS=30
KIRITO_STATE_PATH=/app/data/kirito_state.json

# --- Runtime ---
BOT_POLL_INTERVAL_SECONDS=1.0
BOT_REQUEST_TIMEOUT_SECONDS=10.0
BOT_LOG_LEVEL=INFO
BOT_POLY_FAK_CONFIRM_ORDER=true

# Polymarket CLOB market WebSocket for faster best ask reads.
BOT_POLY_WS_ENABLED=true
BOT_POLY_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
BOT_POLY_WS_MAX_AGE_SEC=12.0
